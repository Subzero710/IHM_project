<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ensisa.ihm_project.MainController">
    <top>
        <MenuBar accessibleText="File" BorderPane.alignment="CENTER">
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#quitMenuAction" text="Leave Application" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Edit">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Delete" />
                        <MenuItem mnemonicParsing="false" onAction="#lineariserAction" text="Linearize" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>
    <center>
        <Pane fx:id="drawArea" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="300.0" prefWidth="300.0" style="-fx-background-color: #fff; -fx-border-color: #eee;" BorderPane.alignment="CENTER">
            <children>
                <Line startX="20.0" startY="20.0" endX="20.0" endY="275.0" stroke="BLACK" />
                <Line startX="20.0" startY="275.0" endX="275.0" endY="275.0" stroke="BLACK" />
                <Polyline fx:id="courbePolyline" fill="TRANSPARENT" stroke="BLACK" strokeWidth="2.0" />
            </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
        </Pane>
    </center>
</BorderPane>
